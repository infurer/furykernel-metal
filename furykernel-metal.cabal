cabal-version: 3.0
-- SPDX-FileCopyrightText: 2026 Mika Tammi
-- SPDX-License-Identifier: BSD-3-Clause
--
-- The header sits below `cabal-version` because from spec 2.2 on that field
-- must be the file's first line, not even preceded by a comment.
name: furykernel-metal
version: 0.2.0.0
synopsis: The Apple Metal target of FuryKernel
description:
  furykernel-metal implements FuryKernel's target interface for Apple GPUs:
  target descriptions, and the lowering of checked kernels to Metal Shading
  Language with the launch tables runtimes read. It emits source only;
  runtimes compile it with Metal.

homepage: https://github.com/infurer/furykernel-metal
license: BSD-3-Clause
license-file: LICENSES/BSD-3-Clause.txt
author: Mika Tammi
maintainer: mikatammi@gmail.com
copyright: 2026 Mika Tammi
category: Compilers/Interpreters
build-type: Simple
extra-doc-files: README.md
tested-with: ghc ==9.12.3

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wmissing-export-lists

common extensions
  default-language: GHC2024
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings
    StrictData
    TypeFamilies

library
  import: warnings, extensions
  hs-source-dirs: src
  exposed-modules:
    FuryKernel.Metal
    FuryKernel.Metal.Target

  build-depends:
    base >=4.21 && <5,
    furykernel >=0.2 && <0.3,
    text >=2.1 && <2.2,

test-suite furykernel-metal-test
  import: warnings, extensions
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: Test.FuryKernel.Metal.TargetTest
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    furykernel,
    furykernel-metal,
    tasty >=1.5 && <1.6,
    tasty-hunit >=0.10 && <0.11,
